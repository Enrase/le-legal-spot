const colorClasses: Record<string, { bg: string; text: string; glow: string }> = {
  indigo: { bg: 'from-indigo-500/20 to-indigo-600/5', text: 'text-indigo-400', glow: 'shadow-indigo-500/20' },
  purple: { bg: 'from-purple-500/20 to-purple-600/5', text: 'text-purple-400', glow: 'shadow-purple-500/20' },
  cyan: { bg: 'from-cyan-500/20 to-cyan-600/5', text: 'text-cyan-400', glow: 'shadow-cyan-500/20' },
  pink: { bg: 'from-pink-500/20 to-pink-600/5', text: 'text-pink-400', glow: 'shadow-pink-500/20' },
  emerald: { bg: 'from-emerald-500/20 to-emerald-600/5', text: 'text-emerald-400', glow: 'shadow-emerald-500/20' },
  amber: { bg: 'from-amber-500/20 to-amber-600/5', text: 'text-amber-400', glow: 'shadow-amber-500/20' },
};
---

<section id="expertise" class="relative py-32 overflow-hidden">
  <!-- Background orbs -->
  <div class="absolute top-20 left-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
  <div class="absolute bottom-20 right-1/4 w-[300px] h-[300px] bg-purple-500/10 rounded-full blur-[100px]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16" data-animate>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass mb-6">
        <span class="w-2 h-2 bg-indigo-400 rounded-full"></span>
        <span class="text-sm font-medium text-theme-secondary">Nos Expertises</span>
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-theme-primary">
        Un accompagnement <span class="text-gradient">complet</span>
      </h2>
      <p class="text-xl text-theme-secondary max-w-2xl mx-auto">
        Du premier pitch deck à l'exit, on sécurise chaque étape de votre croissance.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="bento-grid" data-animate>
      {expertises.map((expertise, index) => (
        <div
          class={`bento-item ${expertise.size} tilt-card group`}
          data-tilt
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class={`tilt-card-inner glass spotlight h-full p-8 flex flex-col ${expertise.featured ? 'justify-between' : 'justify-start'}`}>
            <!-- Shine effect -->
            <div class="tilt-shine"></div>

            <!-- Gradient overlay on hover -->
            <div class={`absolute inset-0 bg-gradient-to-br ${colorClasses[expertise.color].bg} opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-[inherit]`}></div>

            <div class="relative z-10">
              <!-- Icon with animated border -->
              <div class={`w-16 h-16 rounded-2xl glass flex items-center justify-center mb-6 ${colorClasses[expertise.color].text} group-hover:scale-110 transition-all duration-300 ${expertise.featured ? 'animated-border' : ''}`}>
                <Fragment set:html={expertise.icon} />
              </div>

              <!-- Content -->
              <h3 class={`font-bold mb-3 text-theme-primary group-hover:text-gradient transition-all duration-300 ${expertise.featured ? 'text-2xl md:text-3xl' : 'text-xl'}`}>
                {expertise.title}
              </h3>
              <p class={`text-theme-secondary leading-relaxed ${expertise.featured ? 'text-lg mb-8' : 'mb-4 text-sm'}`}>
                {expertise.description}
              </p>
            </div>

            <!-- Tags -->
            <div class="relative z-10 flex flex-wrap gap-2 mt-auto">
              {expertise.tags.map((tag) => (
                <span class={`text-xs px-3 py-1.5 rounded-full glass text-theme-muted`}>
                  {tag}
                </span>
              ))}
            </div>

            {/* Featured card CTA */}
            {expertise.featured && (
              <a href="#contact" class="relative z-10 mt-6 inline-flex items-center gap-2 text-indigo-400 font-medium group/link">
                En savoir plus
                <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Optimized 3D Tilt Effect with smooth interpolation
  document.querySelectorAll('[data-tilt]').forEach((card) => {
    const inner = card.querySelector('.tilt-card-inner') as HTMLElement;
    if (!inner) return;

    let targetRotateX = 0;
    let targetRotateY = 0;
    let currentRotateX = 0;
    let currentRotateY = 0;
    let rafId: number;
    let isHovering = false;

    const ease = 0.1;

    const animate = () => {
      currentRotateX += (targetRotateX - currentRotateX) * ease;
      currentRotateY += (targetRotateY - currentRotateY) * ease;

      inner.style.transform = `perspective(1000px) rotateX(${currentRotateX}deg) rotateY(${currentRotateY}deg) translateZ(5px)`;

      if (isHovering || Math.abs(targetRotateX - currentRotateX) > 0.01 || Math.abs(targetRotateY - currentRotateY) > 0.01) {
        rafId = requestAnimationFrame(animate);
      }
    };

    card.addEventListener('mouseenter', () => {
      isHovering = true;
      cancelAnimationFrame(rafId);
      animate();
    });

    card.addEventListener('mousemove', (e) => {
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // Reduced rotation for subtler effect
      targetRotateX = (y - centerY) / 30;
      targetRotateY = (centerX - x) / 30;

      // Update spotlight position
      (card as HTMLElement).style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);
    }, { passive: true });

    card.addEventListener('mouseleave', () => {
      isHovering = false;
      targetRotateX = 0;
      targetRotateY = 0;
    });
  });
</script>
