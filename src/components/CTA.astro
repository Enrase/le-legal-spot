---
---

<section id="contact" class="relative py-32 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-t from-indigo-500/15 via-purple-500/10 to-transparent rounded-full blur-[120px]"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
    <div data-animate>
      <!-- Badge -->
      <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full glass mb-8 glow-sm">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
        </span>
        <span class="text-sm font-medium text-theme-secondary">Disponible pour de nouveaux clients</span>
      </div>

      <h2 class="text-4xl md:text-6xl font-bold mb-6 text-theme-primary">
        Prêt à <span class="text-gradient">sécuriser</span><br/>
        votre croissance ?
      </h2>

      <p class="text-xl text-theme-secondary max-w-2xl mx-auto mb-12">
        Première consultation offerte pour évaluer vos besoins juridiques.
        Réponse garantie sous 24h.
      </p>

      <!-- Contact Options with enhanced glass -->
      <div class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto mb-12">
        <!-- Calendar Booking -->
        <a
          href="#"
          class="group glass-premium rounded-2xl p-8 text-left hover:glow-sm transition-all duration-300"
        >
          <div class="w-14 h-14 rounded-xl glass flex items-center justify-center mb-4 text-indigo-400 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-theme-primary group-hover:text-gradient transition-all duration-300">
            Réserver un appel
          </h3>
          <p class="text-theme-secondary text-sm">
            30 minutes pour discuter de vos enjeux. Sans engagement.
          </p>
        </a>

        <!-- Email Contact -->
        <a
          href="mailto:contact@legalspot.fr"
          class="group glass-premium rounded-2xl p-8 text-left hover:glow-sm transition-all duration-300"
        >
          <div class="w-14 h-14 rounded-xl glass flex items-center justify-center mb-4 text-indigo-400 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-theme-primary group-hover:text-gradient transition-all duration-300">
            Nous écrire
          </h3>
          <p class="text-theme-secondary text-sm">
            contact@legalspot.fr — Réponse sous 24h garantie.
          </p>
        </a>
      </div>

      <!-- Trust Elements with glass pills -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm">
        <div class="flex items-center gap-2 px-4 py-2 glass rounded-full">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-theme-secondary">Premier RDV offert</span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 glass rounded-full">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-theme-secondary">Sans engagement</span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 glass rounded-full">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-theme-secondary">Devis sous 48h</span>
        </div>
      </div>
    </div>
  </div>
</section>
