---
import Marquee from './Marquee.astro';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
  <!-- Cursor Glow Effect -->
  <div id="cursor-glow" class="cursor-glow hidden lg:block"></div>

  <!-- Background Effects -->
  <div class="absolute inset-0 bg-mesh opacity-70"></div>
  <div class="absolute inset-0 bg-grid"></div>

  <!-- Animated Orbs - enhanced for better glassmorphism effect -->
  <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-indigo-500/25 rounded-full blur-[150px] animate-pulse-glow"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-purple-500/20 rounded-full blur-[120px] animate-pulse-glow" style="animation-delay: 2s;"></div>
  <div class="absolute top-1/2 right-1/3 w-[300px] h-[300px] bg-cyan-500/15 rounded-full blur-[100px] animate-float"></div>
  <div class="absolute bottom-1/3 left-1/3 w-[250px] h-[250px] bg-pink-500/10 rounded-full blur-[80px] animate-float" style="animation-delay: 3s;"></div>

  <!-- Floating glass elements for depth -->
  <div class="absolute top-32 right-20 w-24 h-24 glass rounded-2xl rotate-12 animate-float-slow opacity-40 hidden lg:flex items-center justify-center">
    <svg class="w-10 h-10 text-indigo-400/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
    </svg>
  </div>
  <div class="absolute bottom-40 left-16 w-20 h-20 glass rounded-xl -rotate-6 animate-float-reverse opacity-30 hidden lg:flex items-center justify-center" style="animation-delay: 1s;">
    <svg class="w-8 h-8 text-purple-400/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3" />
    </svg>
  </div>
  <div class="absolute top-1/2 right-10 w-16 h-16 glass rounded-lg rotate-45 animate-float opacity-20 hidden lg:flex items-center justify-center" style="animation-delay: 2s;">
    <svg class="w-6 h-6 text-cyan-400/50 -rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
    </svg>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
    <!-- Badge with enhanced glass -->
    <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full glass animate-fade-in-up glow-sm">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
      </span>
      <span class="text-sm font-medium text-theme-secondary">Cabinet spécialisé Tech & IA</span>
    </div>

    <!-- Main Headline with animated gradient -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-tight mt-8 mb-6 animate-fade-in-up delay-100">
      <span class="block text-theme-primary">Le droit</span>
      <span class="text-gradient animate-gradient">à l'ère de l'IA</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-xl md:text-2xl text-theme-secondary max-w-3xl mx-auto mb-12 animate-fade-in-up delay-200 leading-relaxed">
      Accompagnement juridique sur-mesure pour les entrepreneurs tech.
      <span class="text-theme-primary font-medium">RGPD, IA Act, Propriété Intellectuelle, Contrats SaaS</span> — nous parlons votre langage.
    </p>

    <!-- CTA Buttons with magnetic effect -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up delay-300">
      <a
        href="#contact"
        class="magnetic-btn btn-primary px-8 py-4 rounded-2xl text-lg font-semibold text-white inline-flex items-center gap-3 glow-intense"
        data-magnetic
      >
        Réserver une consultation
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href="#expertise"
        class="magnetic-btn btn-secondary px-8 py-4 rounded-2xl text-lg font-semibold text-theme-primary inline-flex items-center gap-3"
        data-magnetic
      >
        Découvrir nos expertises
      </a>
    </div>

    <!-- Trust Indicators - Marquee -->
    <div class="mt-20 animate-fade-in-up delay-400">
      <p class="text-sm text-theme-muted mb-6 uppercase tracking-wider font-medium">Ils nous font confiance</p>
      <Marquee />
      <Marquee reverse={true} speed="slow" />
    </div>
  </div>

  <!-- Scroll Indicator with glass effect -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <div class="glass w-8 h-14 rounded-full flex items-start justify-center p-2">
      <div class="w-2 h-4 bg-gradient-to-b from-indigo-500 to-purple-500 rounded-full animate-pulse"></div>
    </div>
  </div>

  <!-- Bottom gradient fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[var(--bg-primary)] to-transparent"></div>
</section>

<script>
  // Optimized Cursor Glow Effect using transform (GPU accelerated)
  const cursorGlow = document.getElementById('cursor-glow');

  if (cursorGlow && window.innerWidth >= 1024) {
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let currentX = mouseX;
    let currentY = mouseY;
    let rafId: number;

    // Smoother easing factor
    const ease = 0.08;

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    }, { passive: true });

    function animateCursor() {
      // Smooth interpolation
      currentX += (mouseX - currentX) * ease;
      currentY += (mouseY - currentY) * ease;

      // Use transform instead of left/top for GPU acceleration
      cursorGlow.style.transform = `translate3d(${currentX - 250}px, ${currentY - 250}px, 0)`;

      rafId = requestAnimationFrame(animateCursor);
    }

    animateCursor();

    // Cleanup on page hide
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else {
        animateCursor();
      }
    });
  }

  // Optimized Magnetic Button Effect
  document.querySelectorAll('[data-magnetic]').forEach((btn) => {
    let rafId: number;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const animate = () => {
      currentX += (targetX - currentX) * 0.15;
      currentY += (targetY - currentY) * 0.15;

      (btn as HTMLElement).style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;

      if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
        rafId = requestAnimationFrame(animate);
      }
    };

    btn.addEventListener('mousemove', (e) => {
      const rect = (btn as HTMLElement).getBoundingClientRect();
      targetX = (e.clientX - rect.left - rect.width / 2) * 0.15;
      targetY = (e.clientY - rect.top - rect.height / 2) * 0.15;

      cancelAnimationFrame(rafId);
      animate();
    }, { passive: true });

    btn.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
      cancelAnimationFrame(rafId);
      animate();
    });
  });
</script>
