---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-mesh opacity-70"></div>
  <div class="absolute inset-0 bg-grid"></div>

  <!-- Animated Orbs - enhanced for better glassmorphism effect -->
  <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-indigo-500/25 rounded-full blur-[150px] animate-pulse-glow"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-purple-500/20 rounded-full blur-[120px] animate-pulse-glow" style="animation-delay: 2s;"></div>
  <div class="absolute top-1/2 right-1/3 w-[300px] h-[300px] bg-cyan-500/15 rounded-full blur-[100px] animate-float"></div>
  <div class="absolute bottom-1/3 left-1/3 w-[250px] h-[250px] bg-pink-500/10 rounded-full blur-[80px] animate-float" style="animation-delay: 3s;"></div>

  <!-- Floating glass elements for depth -->
  <div class="absolute top-32 right-20 w-20 h-20 glass-light rounded-2xl rotate-12 animate-float opacity-40 hidden lg:block"></div>
  <div class="absolute bottom-40 left-16 w-16 h-16 glass-light rounded-xl -rotate-6 animate-float opacity-30 hidden lg:block" style="animation-delay: 1s;"></div>
  <div class="absolute top-1/2 right-10 w-12 h-12 glass-light rounded-lg rotate-45 animate-float opacity-20 hidden lg:block" style="animation-delay: 2s;"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
    <!-- Badge with enhanced glass -->
    <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full glass animate-fade-in-up glow-sm">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
      </span>
      <span class="text-sm font-medium text-theme-secondary">Cabinet spécialisé Tech & IA</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-tight mt-8 mb-6 animate-fade-in-up delay-100">
      <span class="block text-theme-primary">Le droit</span>
      <span class="text-gradient">à l'ère de l'IA</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-xl md:text-2xl text-theme-secondary max-w-3xl mx-auto mb-12 animate-fade-in-up delay-200 leading-relaxed">
      Accompagnement juridique sur-mesure pour les entrepreneurs tech.
      <span class="text-theme-primary font-medium">RGPD, IA Act, Propriété Intellectuelle, Contrats SaaS</span> — nous parlons votre langage.
    </p>

    <!-- CTA Buttons with enhanced glass -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up delay-300">
      <a
        href="#contact"
        class="btn-primary px-8 py-4 rounded-2xl text-lg font-semibold text-white inline-flex items-center gap-3 glow-intense"
      >
        Réserver une consultation
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href="#expertise"
        class="btn-secondary px-8 py-4 rounded-2xl text-lg font-semibold text-theme-primary inline-flex items-center gap-3"
      >
        Découvrir nos expertises
      </a>
    </div>

    <!-- Trust Indicators with glass cards -->
    <div class="mt-24 animate-fade-in-up delay-400">
      <p class="text-sm text-theme-muted mb-8 uppercase tracking-wider font-medium">Ils nous font confiance</p>
      <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
        <div class="glass px-6 py-3 rounded-xl text-sm font-medium text-theme-secondary flex items-center gap-2 hover:glow-sm transition-all duration-300">
          <div class="w-2 h-2 rounded-full bg-indigo-400"></div>
          STARTUP IA
        </div>
        <div class="glass px-6 py-3 rounded-xl text-sm font-medium text-theme-secondary flex items-center gap-2 hover:glow-sm transition-all duration-300">
          <div class="w-2 h-2 rounded-full bg-purple-400"></div>
          FINTECH CO
        </div>
        <div class="glass px-6 py-3 rounded-xl text-sm font-medium text-theme-secondary flex items-center gap-2 hover:glow-sm transition-all duration-300">
          <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
          SAAS STUDIO
        </div>
        <div class="glass px-6 py-3 rounded-xl text-sm font-medium text-theme-secondary flex items-center gap-2 hover:glow-sm transition-all duration-300">
          <div class="w-2 h-2 rounded-full bg-pink-400"></div>
          DEEP TECH
        </div>
        <div class="glass px-6 py-3 rounded-xl text-sm font-medium text-theme-secondary flex items-center gap-2 hover:glow-sm transition-all duration-300">
          <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
          AI LABS
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator with glass effect -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <div class="glass w-8 h-14 rounded-full flex items-start justify-center p-2">
      <div class="w-2 h-4 bg-gradient-to-b from-indigo-500 to-purple-500 rounded-full animate-pulse"></div>
    </div>
  </div>

  <!-- Bottom gradient fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[var(--bg-primary)] to-transparent"></div>
</section>
