---
const aiTopics = [
  {
    number: '01',
    title: 'Classification des risques',
    description: 'Identifiez le niveau de risque de votre système IA selon le règlement européen. Risque inacceptable, haut risque, risque limité ou minimal.',
  },
  {
    number: '02',
    title: 'Documentation technique',
    description: 'Préparation de la documentation technique obligatoire : évaluation de conformité, gestion des risques, qualité des données.',
  },
  {
    number: '03',
    title: 'Gouvernance & Transparence',
    description: 'Mise en place des processus de supervision humaine et des obligations de transparence envers les utilisateurs.',
  },
  {
    number: '04',
    title: 'Responsabilité & Assurance',
    description: 'Analyse des régimes de responsabilité spécifiques à l\'IA et structuration de la couverture assurantielle.',
  },
];
---

<section id="ia" class="relative py-32 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-purple-500/15 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[100px]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left Column - Content -->
      <div data-animate>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass mb-6">
          <span class="w-2 h-2 bg-purple-400 rounded-full"></span>
          <span class="text-sm font-medium text-theme-secondary">Focus IA</span>
        </div>

        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-theme-primary">
          L'<span class="text-gradient">IA Act</span> arrive.<br/>
          Êtes-vous prêt ?
        </h2>
        <p class="text-xl text-theme-secondary mb-8 leading-relaxed">
          Le règlement européen sur l'Intelligence Artificielle entre en vigueur progressivement à partir de 2024.
          <span class="text-theme-primary font-medium">Ne subissez pas la réglementation, anticipez-la.</span>
        </p>

        <!-- Stats with glass -->
        <div class="grid grid-cols-3 gap-4 mb-10">
          <div class="text-center p-5 glass rounded-2xl">
            <div class="text-3xl font-bold text-gradient mb-1">35M€</div>
            <div class="text-xs text-theme-muted">Amende max.</div>
          </div>
          <div class="text-center p-5 glass rounded-2xl">
            <div class="text-3xl font-bold text-gradient mb-1">2025</div>
            <div class="text-xs text-theme-muted">Entrée en vigueur</div>
          </div>
          <div class="text-center p-5 glass rounded-2xl">
            <div class="text-3xl font-bold text-gradient mb-1">4</div>
            <div class="text-xs text-theme-muted">Niveaux de risque</div>
          </div>
        </div>

        <a
          href="#contact"
          class="btn-primary inline-flex items-center gap-3 px-8 py-4 rounded-2xl font-semibold text-white glow"
        >
          Audit IA Act gratuit
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right Column - Process Cards -->
      <div class="space-y-4" data-animate>
        {aiTopics.map((topic, index) => (
          <div
            class="group relative glass rounded-2xl p-6 hover:glow-sm transition-all duration-500 cursor-pointer"
            style={`animation-delay: ${index * 100}ms`}
          >
            <!-- Number Badge -->
            <div class="absolute -left-4 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-gradient-to-br from-purple-500 to-indigo-500 flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-purple-500/30">
              {topic.number}
            </div>

            <div class="pl-6">
              <h3 class="text-lg font-bold mb-2 text-theme-primary group-hover:text-gradient transition-all duration-300">
                {topic.title}
              </h3>
              <p class="text-theme-secondary text-sm leading-relaxed">
                {topic.description}
              </p>
            </div>

            <!-- Hover Arrow -->
            <div class="absolute right-6 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- AI Visual Element -->
    <div class="mt-20 relative" data-animate>
      <div class="glass-premium rounded-3xl p-8 md:p-12 overflow-hidden relative">
        <!-- Code-like background decoration -->
        <div class="absolute inset-0 opacity-[0.03]">
          <pre class="text-xs text-purple-300 p-4 overflow-hidden font-mono">
{`{
  "ai_system": {
    "classification": "high_risk",
    "category": "biometric_identification",
    "obligations": [
      "conformity_assessment",
      "human_oversight",
      "transparency_requirements",
      "data_governance"
    ],
    "compliance_deadline": "2025-08-02"
  }
}`}
          </pre>
        </div>

        <div class="relative z-10 text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass mb-6">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-400"></span>
            </span>
            <span class="text-sm text-purple-400 font-medium">Analyse IA en temps réel</span>
          </div>

          <h3 class="text-2xl md:text-3xl font-bold mb-4 text-theme-primary">
            Votre système IA est-il conforme ?
          </h3>
          <p class="text-theme-secondary max-w-2xl mx-auto mb-8">
            En 5 minutes, obtenez une première analyse de conformité de votre système d'intelligence artificielle au regard du règlement européen.
          </p>

          <a
            href="#contact"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl font-semibold glass border-2 border-purple-500/50 text-theme-primary hover:bg-purple-500/10 hover:border-purple-500 transition-all duration-300"
          >
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Lancer le diagnostic
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
