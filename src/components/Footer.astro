---
const footerLinks = {
  expertise: [
    { label: 'RGPD & Conformité', href: '#' },
    { label: 'IA Act', href: '#' },
    { label: 'Contrats Tech', href: '#' },
    { label: 'Propriété Intellectuelle', href: '#' },
    { label: 'Levée de fonds', href: '#' },
  ],
  cabinet: [
    { label: 'Notre équipe', href: '#' },
    { label: 'Notre approche', href: '#' },
    { label: 'Honoraires', href: '#' },
    { label: 'Blog', href: '#' },
  ],
  legal: [
    { label: 'Mentions légales', href: '#' },
    { label: 'Politique de confidentialité', href: '#' },
    { label: 'CGU', href: '#' },
  ],
};

const socialLinks = [
  {
    label: 'LinkedIn',
    href: '#',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
  },
  {
    label: 'Twitter',
    href: '#',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
];
---

<footer class="relative pt-20 pb-10 border-t border-[var(--glass-border)]">
  <!-- Background subtle effect -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-indigo-500/5 rounded-full blur-[100px]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-block mb-6">
          <img
            src="https://cdn.prod.website-files.com/625ec0b9b988873895f94bcc/685d3afb112864361a8f5b8e_Logo%20LegalSpot.svg"
            alt="Le Legal Spot"
            class="h-10 w-auto"
          />
        </a>
        <p class="text-theme-secondary mb-6 max-w-sm leading-relaxed">
          Cabinet d'avocats spécialisé dans l'accompagnement juridique des entrepreneurs tech et des projets innovants.
        </p>
        <!-- Social Links with glass -->
        <div class="flex items-center gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              class="w-11 h-11 rounded-xl glass flex items-center justify-center text-theme-muted hover:text-theme-primary hover:glow-sm transition-all duration-300"
              aria-label={social.label}
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Expertise Links -->
      <div>
        <h4 class="text-sm font-semibold text-theme-primary uppercase tracking-wider mb-4">Expertise</h4>
        <ul class="space-y-3">
          {footerLinks.expertise.map((link) => (
            <li>
              <a href={link.href} class="text-theme-secondary hover:text-theme-primary transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cabinet Links -->
      <div>
        <h4 class="text-sm font-semibold text-theme-primary uppercase tracking-wider mb-4">Le Cabinet</h4>
        <ul class="space-y-3">
          {footerLinks.cabinet.map((link) => (
            <li>
              <a href={link.href} class="text-theme-secondary hover:text-theme-primary transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal Links -->
      <div>
        <h4 class="text-sm font-semibold text-theme-primary uppercase tracking-wider mb-4">Légal</h4>
        <ul class="space-y-3">
          {footerLinks.legal.map((link) => (
            <li>
              <a href={link.href} class="text-theme-secondary hover:text-theme-primary transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar with glass -->
    <div class="pt-8 border-t border-[var(--glass-border)]">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-theme-muted">
          © {new Date().getFullYear()} Le Legal Spot. Tous droits réservés.
        </p>
        <p class="text-sm text-theme-muted">
          Inscrit au Barreau de Paris
        </p>
      </div>
    </div>
  </div>
</footer>
